{
    "compilerOptions": {
        // Enable latest features
        "lib": ["ESNext", "DOM"],
        "sourceMap": true, // создаёт .map файлы для дебага
        "declaration": true, // создаёт .d.ts файлы для TS
        "declarationMap": true,
        "inlineSources": true, // включить исходный код в .map
        "target": "ES2020",
        "module": "ESNext",
        "moduleDetection": "force",

        "jsx": "preserve",
        "jsxImportSource": "react",

        "allowJs": true,

        // Library mode
        "moduleResolution": "bundler",
        "allowImportingTsExtensions": true,
        "verbatimModuleSyntax": false,
        "outDir": "dist",
        "rootDir": "src",
        // Самоимпорт по имени пакета — так `src/ssr` берёт клиентские руты,
        // не втягивая их код в серверный вход (см. docs/ssr.md). Для TS путь
        // указывает в исходники, для сборки импорт остаётся внешним.
        "paths": {
            "@swarm.ing/pieui": ["./src/index.ts"],
            "@swarm.ing/pieui/telegram": ["./src/telegram/index.ts"],
            "@swarm.ing/pieui/max": ["./src/max/index.ts"]
        },

        // Best practices
        "strict": true,
        "types": ["react", "node"], // типы для React + Node (SSR)

        "skipLibCheck": true,
        "noFallthroughCasesInSwitch": true,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,

        // Some stricter flags (disabled by default)
        "noUnusedLocals": false,
        "noUnusedParameters": false,
        "noPropertyAccessFromIndexSignature": false
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules", "dist", "src/cli-schema.d.ts", "src/cli.ts"]
}
